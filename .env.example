SPRINTFLOW_DB_PASSWORD=
# AES-256-GCM key for secrets at rest: Base64 of 32 random bytes. The start scripts generate it.
# Keep it with your backups; without it encrypted values cannot be read. See docs/adr/0015.
SPRINTFLOW_ENCRYPTION_KEY=
# Only during key rotation: retired keys, comma separated, until the re-encryption job is done.
SPRINTFLOW_ENCRYPTION_PREVIOUS_KEYS=
SPRINTFLOW_DB_URL=jdbc:postgresql://localhost:5432/sprintflow
SPRINTFLOW_DB_USER=sprintflow
# Secure cookies by default. The local start scripts write false into a new .env for http://localhost.
SPRINTFLOW_COOKIE_SECURE=true
SPRINTFLOW_PUBLIC_URL=http://localhost:8081
SPRINTFLOW_GOOGLE_CLIENT_ID=
SPRINTFLOW_SMTP_USERNAME=
SPRINTFLOW_SMTP_PASSWORD=
# Optional account services; leave blank to use email/password accounts only.
SPRINTFLOW_SMTP_HOST=smtp.gmail.com
SPRINTFLOW_SMTP_PORT=587
# Linux: set these to the output of id -u and id -g for writable uploads.
SPRINTFLOW_CONTAINER_UID=1000
SPRINTFLOW_CONTAINER_GID=1000
# Host ports. The start scripts validate them; start-native also serves Spring Boot on SPRINTFLOW_APP_PORT.
SPRINTFLOW_APP_PORT=8081
SPRINTFLOW_DB_PORT=5432
