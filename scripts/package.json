{
  "name": "sprintflow-verification",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && node --test data/apache-subset.test.ts",
    "repository": "node verification/repository-check.ts",
    "smoke": "node verification/container-smoke.ts",
    "responsive": "node verification/responsive.ts",
    "guidance": "node verification/guidance.ts",
    "trusted-types": "node verification/trusted-types.ts",
    "sbom": "cyclonedx-npm --omit dev --package-lock-only --output-reproducible --output-format JSON --output-file ../artifacts/sbom/frontend.cdx.json ../frontend/package.json",
    "screenshots": "node verification/screenshots.ts"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "7.0.1",
    "@types/node": "24",
    "playwright": "1.55.1",
    "typescript": "5.7.2"
  }
}
