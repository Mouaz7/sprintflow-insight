{
  "name": "sprintflow-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run messages:check && vite build",
    "test": "vitest run",
    "check": "npm run messages:check && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run size",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "e2e": "npm --prefix e2e test",
    "storybook": "storybook dev -p 6006 --ci --no-open",
    "storybook:build": "storybook build --disable-telemetry",
    "visual": "npm --prefix e2e run visual",
    "messages:compile": "node scripts/compile-messages.ts",
    "messages:check": "node scripts/compile-messages.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@messageformat/runtime": "3.0.3",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@csstools/postcss-global-data": "4.0.0",
    "@eslint/js": "9.39.5",
    "@messageformat/core": "3.4.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@size-limit/file": "14.3.0",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "postcss-custom-media": "12.0.3",
    "prettier": "3.10.1",
    "size-limit": "14.3.0",
    "storybook": "10.6.7",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.6"
    },
    "workbox-build": {
      "glob": "14.0.6"
    }
  },
  "size-limit": [
    {
      "name": "Initial JavaScript: entry chunk (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "125 kB",
      "gzip": true
    },
    {
      "name": "Tasks route chunk (gzip)",
      "path": "dist/assets/TasksView-*.js",
      "limit": "20.8 kB",
      "gzip": true
    },
    {
      "name": "Backlog/sprints/metrics/updates route chunk (gzip)",
      "path": "dist/assets/ProjectInsights-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "All JavaScript, every route (gzip)",
      "path": "dist/assets/*.js",
      "limit": "426 kB",
      "gzip": true
    },
    {
      "name": "Application CSS (gzip)",
      "path": "dist/assets/*.css",
      "limit": "15 kB",
      "gzip": true
    },
    {
      "name": "Search palette (gzip)",
      "path": "dist/assets/CommandPalette-*.js",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "name": "Keyboard shortcut help (gzip)",
      "path": "dist/assets/ShortcutHelp-*.js",
      "limit": "3 kB",
      "gzip": true
    },
    {
      "name": "Roadmap route chunk (gzip)",
      "path": "dist/assets/RoadmapView-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "Flow analysis route chunk (gzip)",
      "path": "dist/assets/FlowView-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "Custom field definitions route (gzip)",
      "path": "dist/assets/CustomFieldsView-*.js",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "name": "Task custom field editor (gzip)",
      "path": "dist/assets/TaskCustomFields-*.js",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "name": "Forecast route chunk (gzip)",
      "path": "dist/assets/ForecastView-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "Planning poker route chunk (gzip)",
      "path": "dist/assets/PokerView-*.js",
      "limit": "15 kB",
      "gzip": true
    },
    {
      "name": "Time and capacity route chunk (gzip)",
      "path": "dist/assets/TimeView-*.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "Dashboard route chunk (gzip)",
      "path": "dist/assets/DashboardView-*.js",
      "limit": "15 kB",
      "gzip": true
    },
    {
      "name": "Email opt-out route chunk (gzip)",
      "path": "dist/assets/UnsubscribeView-*.js",
      "limit": "3 kB",
      "gzip": true
    },
    {
      "name": "Import and audit route chunk (gzip)",
      "path": "dist/assets/DataView-*.js",
      "limit": "12 kB",
      "gzip": true
    },
    {
      "name": "Sprint planning drawer (gzip)",
      "path": "dist/assets/SprintPlanDrawer-*.js",
      "limit": "8 kB",
      "gzip": true
    },
    {
      "name": "Task duplicate suggestions (gzip)",
      "path": "dist/assets/TaskDuplicateSuggestions-*.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "Two-factor settings and QR encoder (gzip)",
      "path": "dist/assets/TwoFactorSettings-*.js",
      "limit": "11 kB",
      "gzip": true
    },
    {
      "name": "Lazy passkey sign-in, settings and browser WebAuthn helpers (gzip)",
      "path": "dist/assets/{PasskeySignIn,PasskeySettings,passkeys}-*.js",
      "limit": "3.5 kB",
      "gzip": true
    },
    {
      "name": "Organizations route (gzip)",
      "path": "dist/assets/OrganizationView-*.js",
      "limit": "12 kB",
      "gzip": true
    },
    {
      "name": "Shared text editor (gzip)",
      "path": "dist/assets/SharedTextDrawer-*.js",
      "limit": "30 kB",
      "gzip": true
    },
    {
      "name": "Flow signals panel (gzip)",
      "path": "dist/assets/FlowSignalsPanel-*.js",
      "limit": "3 kB",
      "gzip": true
    },
    {
      "name": "Automation route (gzip)",
      "path": "dist/assets/AutomationView-*.js",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "name": "Lazy task GitHub links panel (gzip)",
      "path": "dist/assets/TaskGithubLinks-*.js",
      "limit": "1.2 kB",
      "gzip": true
    },
    {
      "name": "Lazy API tokens and outgoing webhooks (gzip)",
      "path": "dist/assets/{ApiTokenSettings,OutboundWebhookPanel}-*.js",
      "limit": "6.5 kB",
      "gzip": true
    }
  ]
}
