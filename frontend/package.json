{
  "name": "sprintflow-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run size",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "e2e": "npm --prefix e2e test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "9.39.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@size-limit/file": "14.3.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jiti": "2.6.1",
    "jsdom": "25.0.1",
    "prettier": "3.10.1",
    "size-limit": "14.3.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "size-limit": [
    {
      "name": "Application JavaScript (gzip)",
      "path": "dist/assets/*.js",
      "limit": "150 kB",
      "gzip": true
    },
    {
      "name": "Application CSS (gzip)",
      "path": "dist/assets/*.css",
      "limit": "15 kB",
      "gzip": true
    }
  ]
}
